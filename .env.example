# Copy this file to .env.local and fill in both values.
# .env.local is git-ignored, so your credentials never reach GitHub.

# The POOLED Postgres connection string — what the running application uses.
# Neon:     Connect → copy the string whose host contains "-pooler"
# Supabase: Project Settings → Database → Connection string → URI on port 6543
DATABASE_URL=

# The DIRECT (unpooled) string — used only by `npm run db:migrate`.
# Neon:     the same Connect modal with pooling switched off (host has no "-pooler")
# Supabase: the same URI on port 5432
# Optional: if you leave it blank the migration falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Any long random string. Signs session cookies, so changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
