# Copy this file to .env.local and fill in both values.
# .env.local is git-ignored, so your credentials never reach GitHub.

# Postgres connection string from Neon or Supabase.
# Neon:     Dashboard → your project → Connection string → "Pooled connection"
# Supabase: Project Settings → Database → Connection string → URI (port 6543)
DATABASE_URL=

# Any long random string. Signs session cookies, so changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
